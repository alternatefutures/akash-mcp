# =============================================================================
# Deployment Secrets for redeploy-all.ts
# =============================================================================
# Copy this file to .env.deploy and fill in your values.
# These match your GitHub Secrets - copy them from the GitHub Settings page.
#
# NEVER commit .env.deploy - it is gitignored.
# =============================================================================

# --- Cloud-API Deployment ---
# YugabyteDB password (used by all YB nodes, auth, and API)
YSQL_PASSWORD=
# Shared JWT signing key (min 32 chars)
JWT_SECRET=
# Resend email service API key
RESEND_API_KEY=
# Arweave wallet JSON (optional, leave empty if not used)
ARWEAVE_WALLET=
# Filecoin wallet private key (optional, leave empty if not used)
FILECOIN_WALLET_KEY=
# Sentry DSN (optional)
SENTRY_DSN=

# --- Auth Deployment ---
# GitHub Container Registry PAT (for pulling private Docker images)
GHCR_PAT=
# JWT refresh secret (optional, defaults to JWT_SECRET + "-refresh")
JWT_REFRESH_SECRET=
