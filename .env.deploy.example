# =============================================================================
# Deployment Secrets — used by redeploy-all.ts, update-auth-env.ts, etc.
# =============================================================================
# These match your GitHub Secrets. NEVER commit this file.
# Copy .env.deploy.example → .env.deploy and fill in values.
# =============================================================================

# --- Database ---
# PostgreSQL password (shared by auth and API services on Akash)
YSQL_PASSWORD=

# --- Auth / JWT ---
# Shared JWT signing key (must match across auth + cloud-api; min 32 chars)
JWT_SECRET=
# JWT refresh secret (optional — defaults to JWT_SECRET + "-refresh")
JWT_REFRESH_SECRET=

# --- Email ---
# Resend API key (https://resend.com — domain alternatefutures.ai verified)
RESEND_API_KEY=

# --- Docker Registry ---
# GitHub Container Registry PAT (read:packages — for pulling private images)
GHCR_PAT=

# --- Storage (optional — leave empty if not used) ---
ARWEAVE_WALLET=
FILECOIN_WALLET_KEY=

# --- Observability (optional) ---
SENTRY_DSN=
